# FastFly staging smoke-test configuration
FASTFLY_BASE_URL=http://localhost:3000
FASTFLY_API_KEY=ff_test_replace_with_your_staging_key
# Supported values: custom_api, shopify, woocommerce
FASTFLY_PROVIDER=custom_api
FASTFLY_ORDER_ID=node-integration-test-001

# The API accepts POST by default. Set PUT only if your deployed API contract requires it.
FASTFLY_IMPORT_METHOD=POST
FASTFLY_TEST_COD_AMOUNT=2500.00
FASTFLY_TEST_PHONE=03001234567
FASTFLY_TEST_CITY=Lahore
